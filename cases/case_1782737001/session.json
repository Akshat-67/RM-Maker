वा दी जिसके पश्चात् उक्त सम्पत्ति बाबत् के नाम से कार्यालय ने पट्टा विलेख आवंटन/विक्रय-पत्र संख्या D-2341 दिनांक ईस्वी को के हित में निष्पादित कर दिया, उक्त पट्टा-विलेख आवंटन/विक्रय-पत्र का पंजीयन उप-पंजीयक जयपुर सप्तम के यहां दिनांक 19.04.2018 को पुस्तक संख्या, जिल्द संख्या में पृष्ठ संख्या क्रम संख्या पर पंजीबद्ध किया गया तथा अतिरिक्त पुस्तक संख्या 01, जिल्द संख्या 1855 के पृष्ठ संख्या से पर चस्पा किया गया। इस प्रकार उक्त मूल सम्पत्ति का एकमात्र मालिक, स्वामी व अधिकारी हुआ।\n\n\tयह कि तत्पश्चात् ने उक्त फ्लैट को को दिनांक को निष्पादित विक्रय-पत्र के जरिये विक्रय कर दिया, जिसका पंजीयन उप-पंजीयक जयपुर सप्तम के यहां दिनांक 23.04.2018 को पुस्तक संख्या, जिल्द संख्या में पृष्ठ संख्या क्रम संख्या पर पंजीबद्ध किया गया तथा अतिरिक्त पुस्तक संख्या 01, जिल्द संख्या 1858 के पृष्ठ संख्या से पर चस्पा किया गया। इस प्रकार उक्त फ्लैट का एकमात्र मालिक, स्वामी व अधिकारी हुआ।", "payments": []}, "verified_fields": [], "files": [], "processed_files": [], "watch_folder": null, "doc_type": "SD", "sellers_count": "2", "buyers_count": "1", "chain_scenario": "", "selected_template": "", "property_type": "Flat", "legal_report_files": [], "buckets": {"legal": ["cases\\case_1782737001\\buckets\\legal\\LEGAL_REPORT.pdf"]}}