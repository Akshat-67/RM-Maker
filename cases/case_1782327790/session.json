ा कुल क्षेत्रफल 61.00 वर्गगज,, जिसकी चारों सीमाओें में पूर्व की ओर प्लॉट नंबर ए-14 का पूर्वी भाग, पश्चिम की ओर प्लॉट नंबर 13-ए, उत्तर की ओर प्लॉट नंबर 15-ए, तथा दक्षिण की ओर 30 फीट रोड स्थित है, जिसे उक्त विक्रय पत्र में ‘‘उक्त मूल सम्पत्ति’’ कहा गया है, बाबत् श्रीमती सैदन पत्नी स्वर्गीय अब्दुल्ला ने नगर परिषद जयपुर में नियमन राशि व लीज राशि नियमानुसार जमा करवा दी, जिसके पश्चात् नगर परिषद जयपुर ने आवंटन पत्र दिनाँक 07.09.1983 ईस्वी को श्रीमती सैदन पत्नी स्वर्गीय अब्दुल्ला के हित में निष्पादित कर जारी कर दिया, इस प्रकार श्रीमती सैदन पत्नी स्वर्गीय अब्दुल्ला उक्त मूल सम्पत्ति के एकमात्र मालिक, स्वामी व अधिकारी हुई।\n\n\tतत्पश्चात् नगर परिषद जयपुर कार्यालय ने उक्त मूल सम्पत्ति को जरिये कब्जा पत्र दिनांकित 16.11.1983 द्वारा श्रीमती सैदन पत्नी स्वर्गीय अब्दुल्ला को हस्तान्तरित कर दिया, इस प्रकार श्रीमती सैदन पत्नी स्वर्गीय अब्दुल्ला उक्त मूल सम्पत्ति के एकमात्र मालिक, स्वामी व अधिकारी हुई।\n\n\tतत्पश्चात् श्री नूर मोहम्मद पुत्र अब्दुल्ला ने उक्त मूल सम्पत्ति को जरिये पंजीकृत विक्रय पत्र दिनांकित 30.12.2013 द्वारा मोहम्मद रईस पुत्र अब्दुल रशीद को विक्रय कर दिया, जिसका पंजीयन उप-पंजीयक कार्यालय जयपुर षष्ठम के यहां दिनांक 30.12.2013 को पुस्तक संख्या 01 जिल्द संख्या 160 में पृष्ठ संख्या 119 क्रम संख्या 2013396006578 पर पंजीबद्ध किया गया। इस प्रकार मोहम्मद रईस पुत्र अब्दुल रशीद उक्त मूल सम्पत्ति के एकमात्र मालिक, स्वामी व अधिकारी हुए।\n\n\tतत्पश्चात् श्रीमती सैदन पत्नी स्वर्गीय अब्दुल्ला का स्वर्गवास दिनाँक को हो गया। उक्त श्रीमती सैदन पत्नी स्वर्गीय अब्दुल्ला के स्वर्गवास के पश्चात उक्त सम्पत्ति के 1. श्री अब्दुल्ला पुत्र श्रीमती सैदन पत्नी स्वर्गीय अब्दुल्ला, 2. श्री नूर मोहम्मद पुत्र श्रीमती सैदन पत्नी स्वर्गीय अब्दुल्ला, 3. श्री गुलजार पुत्र श्रीमती सैदन पत्नी स्वर्गीय अब्दुल्ला कानूनी उत्तराधिकारीगण होने के कारण उक्त सम्पत्ति में अपने-अपने अविभाजित 1/3 हिस्से के मालिक, स्वामी व अधिकारी हुए।\n\n\tतत्पश्चात् नगर परिषद जयपुर कार्यालय ने अपने अधिकारों का प्रयोग करते हुये उक्त मूल सम्पत्ति पर अपार्टमेंट/यूनिट्स/फ्लैट्स का निर्माण करवा लिया तथा उक्त यूनिट्स/फ्लैट्स को अलग-अलग नम्बरों से चिन्हित कर दिया।", "payments": []}, "verified_fields": [], "files": [], "processed_files": [], "watch_folder": null, "doc_type": "SD", "sellers_count": 2, "buyers_count": 1, "chain_scenario": "JDA_2SD_Flat", "selected_template": "", "property_type": "Plot", "legal_report_files": [], "buckets": {"legal": ["cases\\case_1782327790\\buckets\\legal\\Mar-05_Mohammed_Arif_JDA_PATTA_LAP___Sale_Deed___Ats.pdf"]}}